APP_NAME="Optique Torena"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# Database Configuration (PostgreSQL default for production)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=optique_torena
DB_USERNAME=postgres
DB_PASSWORD=secret

# For local development without a running PostgreSQL server daemon:
# DB_CONNECTION=sqlite
# DB_DATABASE=/path/to/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

FILESYSTEM_DISK=public

ADMIN_EMAIL=admin@optiquetorena.ma
ADMIN_PASSWORD=TorenaAdmin2026!
